{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/site.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/tessela", "destination": "/tessela/index.html" },
    { "source": "/tessela/:path*", "destination": "/tessela/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
