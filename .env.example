# Copie para .env.local (no computador) e configure as mesmas variáveis na Vercel.

# Senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha

# Opcional: chave para assinar a sessão (se vazio, usa a senha)
ADMIN_SECRET=

# Criado automaticamente pela Vercel ao conectar um Blob Store ao projeto.
# Deixe vazio no computador para salvar em arquivos locais (.data/ e public/uploads/).
BLOB_READ_WRITE_TOKEN=
